---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {

title:string;

type:string;

description:string;

image?:ImageMetadata;

live?:string;

github?:string;

tags?:string[];

status?:string;

}

const {

title,
type,
description,
image,
live,
github,
tags=[],
status

}=Astro.props as Props;
---

<article class="project">

{
image && (

<Image
    src={image}
    alt={title}
    width={1200}
    quality={100}
    loading="lazy"
/>

)
}

<div class="project-content">

<p class="project-type">
{type}
</p>

<h3>
{title}
</h3>

<p>
{description}
</p>

{tags.length > 0 && (

<div class="tags">

{
tags.map(tag => (

<span class="tag">
{tag}
</span>

))
}

</div>

)}

{
(status || live || github) && (

<div class="project-links">

{
status && (
<span>
{status}
</span>
)
}

{
live && (
<a href={live} target="_blank">
Live demo →
</a>
)
}

{
github && (
<a href={github} target="_blank">
GitHub →
</a>
)
}

</div>

)
}

</div>

</article>

